  "info": {
    "_postman_id": "dc7b58ba-8238-48b7-88a3-fc7bc39c0af9",
    "name": "Samora AI Calls API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Server-to-server REST API for Samora AI multilingual voice agents. Trigger outbound calls, manage outbound calling campaigns and their scheduled recipients, and subscribe to real-time call events via webhooks. These APIs are intended for server-to-server integrations; the organization API key must never be exposed in browser or mobile clients.\n\nContact Support:\n Name: Samora AI API Support\n Email: vineeth@samora.ai",
      "type": "text/plain"
    }
  }
